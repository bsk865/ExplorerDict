name: Native checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  native:
    runs-on: windows-latest
    env:
      QT_QPA_PLATFORM: offscreen
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
          cache: pip
      - run: python -m pip install -r requirements.txt
      - run: python -m unittest discover -s tests -p "test_native_*.py"
      - run: python -m unittest discover -s tests -p test_library_assistant.py
      - run: python -m unittest discover -s tests -p test_study_weather.py
